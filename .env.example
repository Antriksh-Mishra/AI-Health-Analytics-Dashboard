# MedIntel AI - Environment Configuration Example

# Server & Security
PORT=5001
FLASK_ENV=production
SECRET_KEY=replace-with-a-secure-random-secret-key
JWT_SECRET_KEY=replace-with-a-secure-jwt-secret-key

# Database (Render PostgreSQL or local SQLite)
# For Render PostgreSQL: postgresql://username:password@host/database
# For local SQLite: sqlite:///medintel.db
DATABASE_URL=sqlite:///medintel.db

# Google Gemini AI Integration
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Frontend URL (for CORS if restricting origins in production)
FRONTEND_URL=http://localhost:5173
